# Cloudflare static assets headers (AUDIT item 10). Next's static export inlines scripts/styles, hence 'unsafe-inline'.
# KYC photos are Supabase signed URLs; the API is the only allowed fetch target.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://jyxpisnldtsoyigdjqse.supabase.co; font-src 'self' data:; connect-src 'self' https://api.royalgccforex.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Robots-Tag: noindex, nofollow
